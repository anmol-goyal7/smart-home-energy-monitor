<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.smarthome</groupId>
    <artifactId>smart-home-energy-monitor</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Smart Home Energy Monitor</name>
    <description>
        Multithreaded TCP ingest server, JDBC persistence, Swing dashboard, and a
        rule-based power-quality alerting engine for simulated smart-meter streams.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <mysql.connector.version>9.1.0</mysql.connector.version>
        <junit.version>5.11.4</junit.version>

        <!-- Convenience: main classes for the exec plugin (override on the command line). -->
        <server.mainClass>com.smarthome.energy.server.EnergyMonitorServer</server.mainClass>
        <simulator.mainClass>com.smarthome.energy.simulator.SimulatorLauncher</simulator.mainClass>
        <dashboard.mainClass>com.smarthome.energy.client.DashboardApp</dashboard.mainClass>
        <persistence.mainClass>com.smarthome.energy.db.PersistenceDemo</persistence.mainClass>
    </properties>

    <dependencies>
        <!-- MySQL JDBC driver (Connector/J) for the persistence layer. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- JUnit 5 for the unit tests and the DAO round-trip checks. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>smart-home-energy-monitor</finalName>
        <plugins>
            <!-- Compile against Java 17. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                Surefire runs the JUnit 5 tests on `mvn test`. The DAO tests skip
                themselves when no database is reachable (see ReadingDaoTest), so the
                build stays green on a machine without Docker; the model tests always run.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
                exec:java lets each module be launched without a hand-built classpath, e.g.:
                  mvn exec:java -Dexec.mainClass=${server.mainClass}
                  mvn exec:java -Dexec.mainClass=${simulator.mainClass}
                  mvn exec:java -Dexec.mainClass=${dashboard.mainClass}
                  mvn exec:java -Dexec.mainClass=${persistence.mainClass}
                The server main is the default so a bare `mvn exec:java` starts the server.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${server.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
